# ─────────────────────────────────────────────────────────────────────────────
# FAGE Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Model mode: "simulated" (no API calls) or "live" (real API calls)
FAGE_MODEL_MODE=simulated

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MICRO_MODEL=gpt-3.5-turbo
OPENAI_FLAGSHIP_MODEL=gpt-4o

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MICRO_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_FLAGSHIP_MODEL=claude-sonnet-4-6

# ── Active provider: "openai" or "anthropic" ─────────────────────────────────
FAGE_PROVIDER=openai

# ── Connected platform discovery ──────────────────────────────────────────────
# Use one stable secret to encrypt stored OAuth tokens.
CONNECTION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Salesforce external client app
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/integrations/connections/oauth/salesforce/callback

# ServiceNow OAuth API endpoint for external clients
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_REDIRECT_URI=http://localhost:8000/api/integrations/connections/oauth/servicenow/callback

# ── Real-time video avatar (agents/livekit_avatar_worker.py, agents/ask_costpilot_mcp_server.py) ──
# A second, continuously-running process (Procfile's `livekit-avatar`),
# separate from the web app above. Reuses OPENAI_API_KEY.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Which CostPilot workspace this voice avatar answers questions about --
# see ask_costpilot_mcp_server.py's own comment on why this is fixed per
# deployment rather than asked of the model.
ASK_COSTPILOT_MCP_WORKSPACE_ID=
# Only needed if the MCP server and LiveKit worker run on different
# hosts/dynos -- the Procfile's `livekit-avatar` process runs both on the
# same dyno, so the default (http://127.0.0.1:8100/mcp) already works.
ASK_COSTPILOT_MCP_URL=http://127.0.0.1:8100/mcp
# The real, already-deployed CostPilot app's own base URL -- the MCP
# server calls its /api/reports/bot-efficiency/ask endpoint over HTTP.
# localhost only works when both processes run on the same machine (local
# dev); production must point at the real deployed app URL.
ASK_COSTPILOT_BASE_URL=http://localhost:8000
# Realtime API voice -- NOT the same roster as the standard TTS voice
# used elsewhere in this app (see livekit_avatar_worker.py's own comment).
ASK_COSTPILOT_AVATAR_VOICE=marin
